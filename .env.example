# ── Frontend (Vite) — copy to .env.local for local dev, and add the same
#    variables in Vercel → Project → Settings → Environment Variables.
VITE_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-anon-or-publishable-key
# Public URL of the deployed app (used for auth redirects and QR codes).
VITE_APP_URL=http://localhost:5173
# Set to true after enabling the Google provider in Supabase Auth.
VITE_ENABLE_GOOGLE_AUTH=false
